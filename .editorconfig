# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.lua]
indent_style = space
indent_size = 2

[*.{vim,vimrc}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
indent_style = space
indent_size = 2
# Keep trailing whitespace in Markdown (used for line breaks)
trim_trailing_whitespace = false

[*.{json,yaml,yml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
